# .env.example — Visor web (Vite + React)
# ---------------------------------------------------------------------------
# Copia este archivo a  .env  (o  .env.local ) en este mismo directorio y
# completa el valor. El archivo .env NO se versiona (está en .gitignore).
#
# Vite solo expone al frontend las variables con prefijo  VITE_.
# ---------------------------------------------------------------------------

# URL base de la API central del radar (FastAPI).
# - Desarrollo local:   http://localhost:8000
# - Producción (UTPL):  https://clima.utpl.edu.ec
# Si se omite, el visor usa http://localhost:8000 por defecto
# (ver src/services/radarService.js).
VITE_API_BASE=http://localhost:8000
