# .env.example - Variables de entorno para la API central de TAMIA
# Copiar este archivo como '.env' y ajustar los valores.

# Conexión a PostgreSQL
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/radar_db

# Clave de seguridad para los endpoints de subida (usar en los scripts Edge)
RADAR_API_KEY=CAMBIAR_POR_LA_CLAVE_REAL
