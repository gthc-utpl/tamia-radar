# .env.example — plantilla de configuración del nodo GUAXX
# ---------------------------------------------------------------------------
# Copia este archivo a  .env  (mismo directorio) y completa los valores.
# El archivo .env NO se sube a ningún repositorio ni se comparte (contiene la
# clave de la API). Para ACTUALIZAR el nodo basta copiar los .py; el .env se
# queda intacto en el nodo.
# ---------------------------------------------------------------------------

# OBLIGATORIO — clave de la API central (debe coincidir con RADAR_API_KEY del
# servidor). Sin esto, el uploader no arranca.
RADAR_API_KEY=CAMBIAR_POR_LA_CLAVE_REAL

# URL de la API central. Por defecto http://localhost:8000 si se omite.
RADAR_API_URL=http://localhost:8000

# OPCIONALES — descomenta y ajusta solo si difieren de los valores por defecto
# del script (útil para no editar el .py en el nodo):
# GUAXX_WATCH_DIR=D:\Rainview-Analyzer\Rainview-Analyzer\rainbow\online\RS19\100km.ppi
# GUAXX_PROCESSOR_SCRIPT=./generar_png_radar.py
# GUAXX_OUTPUT_PNG=./output/radar_latest.png
